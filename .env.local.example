# Copy this file to .env.local and fill in your own values.
# Supabase: Project Settings > API Keys (use the publishable key, never a secret key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Anthropic: https://console.anthropic.com (server-only, never prefix with NEXT_PUBLIC_).
ANTHROPIC_API_KEY=
